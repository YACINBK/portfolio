---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectedCredentials, competitionSignals, certificateArchive, education, languages, site, toolkit } from '../data/site';
import { absoluteUrl } from '../utils/paths';

const schema = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: absoluteUrl('/dossier', Astro.site),
    name: `${site.name} credentials`,
    description: 'Certificates, toolkit, education, competitions, and languages.',
};
---

<BaseLayout
    title={`Credentials | ${site.name}`}
    description="Certificates, toolkit, education, competitions, and language skills."
    currentPath="/dossier"
    schema={[schema]}
>
    <div class="page-stack">
        
        <section class="section-block credentials-selected" data-reveal>
            <div class="section-label">Selected Credentials</div>
            
            <div class="credentials-provider">
                <h2>NVIDIA Deep Learning Institute</h2>
                <p>Applied AI systems credentials aligned with retrieval workflows, secure AI pipelines, multimodal processing, predictive maintenance, and language-model application design.</p>
            </div>

            <div class="credential-grid">
                {selectedCredentials.map((cert) => (
                    <article class="credential-card">
                        <span class="credential-trait">{cert.trait}</span>
                        <h3 class="credential-title">{cert.title}</h3>
                        <p class="credential-description">{cert.description}</p>
                        <a href={cert.verifyUrl} target="_blank" rel="noreferrer" class="button-primary button-primary--ghost credential-action">
                            Verify
                        </a>
                    </article>
                ))}
            </div>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Competition Signal</div>
            {competitionSignals.map((item) => (
                <article class="competition-card">
                    <span class="competition-meta">{item.meta}</span>
                    <h3 class="credential-title">{item.title}</h3>
                    <p class="credential-description">{item.description}</p>
                    <a href={item.certificateUrl} target="_blank" rel="noreferrer" class="button-primary button-primary--ghost credential-action">
                        View Certificate
                    </a>
                </article>
            ))}
        </section>

        <section class="section-block" data-reveal>
            <details class="certificate-archive">
                <summary class="section-label">Show verified certificate archive</summary>
                
                <div class="archive-group-list">
                    {certificateArchive.map((group) => (
                        <div class="archive-group">
                            <div class="cert-group__head">
                                <h2>{group.provider}</h2>
                                <span>{group.items.length} linked</span>
                            </div>
                            <div class="archive-rows">
                                {group.items.map((item) => (
                                    <a href={item.url} target="_blank" rel="noreferrer" class="archive-row">
                                        <span>{item.title}</span>
                                        <strong>Verify</strong>
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </details>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Toolkit</div>
            <div class="toolkit-list">
                {toolkit.map((group) => (
                    <article class="toolkit-group">
                        <h2>{group.category}</h2>
                        <ul class="tag-list" aria-label={group.category}>
                            {group.items.map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Education</div>
            <ul class="credential-list">
                {education.map((item) => (
                    <li>
                        <span>{item.range}</span>
                        <strong>{item.institution}</strong>
                        <p>{item.title}{item.note ? ` - ${item.note}` : ''}</p>
                    </li>
                ))}
            </ul>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Languages</div>
            <div class="language-grid">
                {languages.map((lang) => (
                    <div class="language-item">
                        <strong>{lang.name}</strong>
                        <span>{lang.level}</span>
                    </div>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    /* Selected Credentials & Competition Card Styles */
    .credentials-selected {
        margin-bottom: 3rem;
    }
    
    .credentials-provider {
        margin-bottom: 2rem;
    }
    .credentials-provider h2 {
        color: var(--text-main);
        font-size: var(--text-xl);
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .credentials-provider p {
        color: var(--text-soft);
        font-size: var(--text-base);
        line-height: 1.7;
        max-width: 60ch;
    }

    .credential-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    @media (min-width: 768px) {
        .credential-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .credential-card,
    .competition-card {
        background: var(--surface-card, rgba(255, 255, 255, 0.02));
        border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.05));
        border-radius: var(--radius-md, 12px);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        transition: border-color 0.2s ease, background 0.2s ease;
    }
    
    .credential-card:hover,
    .competition-card:hover {
        background: var(--surface-hover, rgba(255, 255, 255, 0.04));
        border-color: var(--cyan-muted, rgba(34, 211, 238, 0.3));
    }

    .credential-trait,
    .competition-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--cyan-bright, #22d3ee);
        margin-bottom: 0.75rem;
        display: inline-block;
    }

    .credential-title {
        font-size: var(--text-lg);
        font-weight: 700;
        color: var(--text-main, #fff);
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }

    .credential-description {
        color: var(--text-soft);
        font-size: var(--text-base);
        line-height: 1.7;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }

    .credential-action {
        font-size: var(--text-xs);
        padding: 0.5rem 1.25rem;
        margin-top: auto;
    }

    /* Archive Styles */
    .certificate-archive {
        margin-top: 1rem;
    }
    
    .certificate-archive > summary {
        cursor: pointer;
        list-style: none;
        display: inline-block;
        transition: color 0.2s ease;
    }
    
    .certificate-archive > summary::-webkit-details-marker {
        display: none; /* Safari */
    }
    
    .certificate-archive > summary:hover {
        color: var(--cyan-bright, #22d3ee);
    }
    
    .certificate-archive > summary::after {
        content: ' +';
        font-family: var(--font-mono);
    }
    
    .certificate-archive[open] > summary::after {
        content: ' -';
    }

    .archive-group-list {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .archive-row {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        background: var(--surface-card, rgba(255, 255, 255, 0.01));
        border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.05));
        border-radius: var(--radius-sm, 8px);
        margin-bottom: 0.5rem;
        gap: 0.5rem;
        text-decoration: none;
        transition: background 0.2s ease;
    }
    
    .archive-row:hover {
        background: var(--surface-hover, rgba(255, 255, 255, 0.04));
    }
    
    @media (min-width: 768px) {
        .archive-row {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
        }
    }

    .archive-row span {
        color: var(--text-main);
        font-size: var(--text-base);
        font-weight: 500;
    }

    .archive-row strong {
        color: var(--cyan-bright);
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
</style>
