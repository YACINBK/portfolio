---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import CvDownloads from '../components/CvDownloads.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../utils/paths';

const schema = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: absoluteUrl('/contact', Astro.site),
    name: `${site.name} contact`,
    description: `Direct ways to reach ${site.name}.`,
};

const profileLabel = (url) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contacts = [
    { label: 'LinkedIn', value: profileLabel(site.linkedin), href: site.linkedin },
    { label: 'GitHub', value: profileLabel(site.github), href: site.github },
    { label: 'Academic email', value: site.academicEmail, href: `mailto:${site.academicEmail}` },
];
---

<BaseLayout
    title={`Contact | ${site.name}`}
    description="Have an internship or a project in mind? Email me directly."
    currentPath="/contact"
    schema={[schema]}
>
    <div class="page-stack">
        <section class="section-block contact-section" aria-labelledby="contact-title">
            <div class="section-label">Contact</div>
            <h1 id="contact-title" class="page-title">Let’s build<br />something useful.</h1>
            <p class="contact-intro">{site.opportunity} Tell me what you’re building and where I could help.</p>

            <a class="contact-direct" href={`mailto:${site.email}`}>
                <span class="contact-info">
                    <span class="contact-label">Email Yassine</span>
                    <strong>{site.email}</strong>
                    <span class="contact-hint">Start a conversation</span>
                </span>
                <span class="contact-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="email-fallback">
                <span>Prefer to paste the address?</span>
                <CopyEmail email={site.email} />
            </div>

            <div class="contact-grid">
                {contacts.map((contact) => (
                    <a class="contact-card" href={contact.href}
                        target={contact.href.startsWith('http') ? '_blank' : undefined}
                        rel={contact.href.startsWith('http') ? 'noreferrer' : undefined}>
                        <span class="contact-info">
                            <span class="contact-label">{contact.label}</span>
                            <strong>{contact.value}</strong>
                        </span>
                        <span class="contact-arrow" aria-hidden="true">↗</span>
                        {contact.href.startsWith('http') && <span class="sr-only">(opens in a new tab)</span>}
                    </a>
                ))}
            </div>

            <div class="contact-cv">
                <CvDownloads />
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }
    .contact-section { max-width: 54rem; }
    .page-title { max-width: none; margin-top: 1.5rem; }
    .contact-intro {
        color: var(--text-soft);
        font-size: var(--text-lg);
        line-height: 1.65;
        margin: 1.25rem 0 2rem;
        max-width: 48ch;
    }
    .contact-direct, .contact-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--border-medium);
        border-radius: 0.5rem;
        color: var(--text-main);
        background: var(--bg-panel);
        text-decoration: none;
        transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
    }
    .contact-direct {
        padding-block: 1.5rem;
        border-color: var(--cyan-main);
        background: var(--cyan-main);
        color: var(--bg-main);
    }
    .contact-direct strong { font-size: clamp(1rem, 3vw, 1.5rem); }
    .contact-direct .contact-label, .contact-direct .contact-hint { color: inherit; }
    .contact-direct:hover, .contact-direct:focus-visible {
        background: var(--cyan-bright);
        transform: translateY(-2px);
    }
    .contact-grid { display: grid; gap: 0.75rem; }
    .contact-card:hover, .contact-card:focus-visible {
        background: var(--cyan-dim);
        border-color: var(--cyan-main);
    }
    .contact-card:hover strong, .contact-card:focus-visible strong { color: var(--cyan-bright); }
    .contact-info { display: flex; flex-direction: column; gap: 0.45rem; min-width: 0; }
    .contact-info strong { overflow-wrap: anywhere; font-weight: 500; }
    .contact-label { font-size: var(--text-sm); color: var(--text-soft); }
    .contact-hint { font-size: var(--text-sm); color: var(--text-muted); }
    .contact-arrow { font-size: var(--text-2xl); transition: transform 180ms ease; }
    a:hover .contact-arrow, a:focus-visible .contact-arrow { transform: translate(3px, -3px); }
    .email-fallback {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem 0.75rem;
        margin: 0.5rem 0 2rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }
    .contact-cv {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid var(--border-medium);
        margin-top: 2rem;
        padding-top: 1.5rem;
    }
    @media (max-width: 560px) {
        .contact-direct, .contact-card { padding: 1rem; gap: 0.75rem; }
    }
</style>
