---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceHighlights from '../components/EvidenceHighlights.astro';
import { automationEntries, focusAreas, projects, site, systemProfile, workEntries } from '../data/site';
import { absoluteUrl, withBase } from '../utils/paths';

const flagship = projects[0];
const internship = workEntries[0];

const bySlug = (list, slug) => list.find((item) => item.slug === slug);

// Selected systems: the RAG flagship, the internship platform, and the automation agent.
const previewSystems = [
    bySlug(projects, 'knowledge-assistant'),
    bySlug(projects, 'ux-insight-platform'),
    bySlug(automationEntries, 'agentic-video-production'),
]
    .filter(Boolean)
    .map((item) => ({
        type: item.type,
        title: item.title,
        summary: item.summary,
        href: bySlug(projects, item.slug)
            ? withBase(`/projects#${item.slug}`)
            : withBase(`/lab#${item.slug}`),
    }));

const profileSchema = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: absoluteUrl('/', Astro.site),
    name: `${site.name} portfolio`,
    description: site.description,
    mainEntity: {
        '@type': 'Person',
        name: site.name,
        jobTitle: site.role,
        email: `mailto:${site.email}`,
        homeLocation: site.location,
        sameAs: [site.github, site.linkedin],
    },
};
---

<BaseLayout title={site.title} description={site.description} currentPath="/" schema={[profileSchema]}>
    <div class="page-stack">
        <section class="home-intro hero-system" data-reveal>
            <div class="home-intro__copy">
                <p class="home-role">
                    <span class="system-status-pip" aria-hidden="true"></span>
                    {site.role}
                </p>
                <h1 class="home-title">{site.name}</h1>
                <p class="page-copy page-copy--lead">{site.intro}</p>
                <p class="page-copy page-copy--impact"><strong>Agent graphs</strong> that pick their own next step. <strong>Retrieval</strong> scoped to who is asking. <strong>Evaluation</strong> that tests retrieval quality and exposes verification blind spots. <strong>Backends that resume</strong> instead of restarting.</p>

                <div class="inline-links">
                    <a class="button-primary" href={withBase('/projects')} data-astro-prefetch>View Projects</a>
                    <a href={withBase(site.cv.href)} download={site.cv.filename}>{site.cv.label}</a>
                    <a href={withBase('/lab')} data-astro-prefetch>Automation Work</a>
                    <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
                    <a href={withBase('/contact')} data-astro-prefetch>Contact</a>
                </div>
            </div>

        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Core direction</div>
            <div class="focus-card-grid">
                {focusAreas.map((item, index) => (
                    <article class="focus-card" style={`--i:${index}`}>
                        <span class="focus-card__node" aria-hidden="true"></span>
                        <h2>{item.title}</h2>
                        <p>{item.description}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Professional experience</div>
            <article class="experience-card experience-card--compact">
                <div class="experience-card__meta">
                    <span>{internship.type}</span>
                    <h2>{internship.role}</h2>
                    <p>{internship.organization}</p>
                    <p>{internship.range}</p>
                    <p>{internship.location}</p>
                </div>
                <div class="experience-card__body">
                    <p>{internship.summary}</p>
                    <div class="experience-groups">
                        {internship.groups.map((group) => (
                            <div>
                                <strong>{group.label}</strong>
                                {group.range && <span class="home-stint-range">{group.range}</span>}
                                <p>{group.items[0]}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </article>
        </section>

        <section class="section-block" data-reveal>
            <div class="section-label">Flagship system</div>
            <article class="spotlight-card">
                <div class="spotlight-card__top">
                    <div>
                        <h2 class="spotlight-card__title">{flagship.title}</h2>
                        <p class="page-copy">{flagship.summary}</p>
                    </div>
                    <span class="spotlight-badge">{flagship.status}</span>
                </div>

                <div class="architecture-strip" aria-label={`${flagship.title} flow`}>
                    {flagship.flow.map((step) => (
                        <span>{step}</span>
                    ))}
                </div>

                <EvidenceHighlights items={flagship.evidence} />

                <div class="inline-links">
                    <a class="button-primary" href={flagship.repository} target="_blank" rel="noreferrer">
                        {site.currentFocusCta}
                    </a>
                    <a href={withBase('/projects#knowledge-assistant-evaluation')} data-astro-prefetch>Read evaluation findings</a>
                    <a href={withBase('/lab#mcp-build-pipeline')} data-astro-prefetch>Explore the MCP build workflow</a>
                </div>
            </article>
        </section>

        <section class="section-block" aria-label="Project preview" data-reveal>
            <div class="section-label">Selected systems</div>
            <div class="repo-preview-grid">
                {previewSystems.map((system) => (
                    <a class="repo-preview-card" href={system.href}>
                        <div class="repo-preview-card__meta">
                            <span class="status-tag status-tag--flagship status-tag--mini">{system.type}</span>
                        </div>
                        <strong>{system.title}</strong>
                        <p>{system.summary}</p>
                        <span class="repo-preview-card__cta">Read details</span>
                    </a>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .home-stint-range {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-soft);
        margin-top: 0.15rem;
    }
</style>
