---
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const { currentPath = '/' } = Astro.props;

const navigation = [
    { href: '/', label: 'Overview' },
    { href: '/work', label: 'Experience' },
    { href: '/projects', label: 'Projects' },
    { href: '/lab', label: 'Automation' },
    { href: '/dossier', label: 'Credentials' },
    { href: '/contact', label: 'Contact' },
];

function normalizePath(pathname = '/') {
    const cleaned = pathname.replace(/[?#].*$/, '').replace(/\/+$/, '');
    return cleaned || '/';
}

function isCurrent(href) {
    const normalizedCurrent = normalizePath(currentPath);
    const normalizedHref = normalizePath(href);
    return normalizedCurrent === normalizedHref;
}
---

<header class="site-header">
    <div class="site-header__inner">
        <a class="brand-lockup" href={withBase('/')} aria-label={`${site.name} home`} data-astro-reload>
            <img src={withBase('/logo.png')} alt={`${site.shortName} Logo`} class="brand-lockup__logo" />
            <span class="brand-lockup__text">
                <strong>{site.name}</strong>
                <span>{site.brandLine}</span>
            </span>
        </a>

        <nav class="route-nav" aria-label="Primary">
            {navigation.map((route) => (
                <a
                    href={withBase(route.href)}
                    aria-current={isCurrent(route.href) ? 'page' : undefined}
                    data-astro-reload
                >
                    {route.label}
                </a>
            ))}
        </nav>

        <a class="header-cv" href={withBase(site.cv.href)} download={site.cv.filename} aria-label="Download CV (PDF)">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 2.5h6l4 4v11H5z M11 2.5v4h4 M10 9v5 M7.5 11.5 10 14l2.5-2.5" />
            </svg>
            <span>CV <small>PDF</small></span>
        </a>
    </div>
</header>
