---
import { site } from '../data/site';
const links = [
    { label: 'GitHub', href: site.github, hint: 'Explore my repositories', kind: 'github', path: 'M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.5v-2.1c-3.4.7-4.1-1.4-4.1-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.4-5.5-6.1 0-1.4.5-2.5 1.2-3.3-.1-.3-.5-1.6.2-3.3 0 0 1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.7.3 3 .2 3.3.8.8 1.2 1.9 1.2 3.3 0 4.7-2.8 5.8-5.5 6.1.4.4.8 1.1.8 2.2V22c0 .3.2.6.8.5A11.1 11.1 0 0 0 12 .9Z' },
    { label: 'LinkedIn', href: site.linkedin, hint: 'Connect with Yassine', kind: 'linkedin', path: 'M5.4 7.8H1.8V22h3.6V7.8ZM3.6 1.5a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2ZM22.2 13.9c0-4.2-2.2-6.2-5.1-6.2-2.4 0-3.4 1.3-4 2.2V7.8H9.5V22h3.6v-7.9c0-2.1.4-4.1 3-4.1 2.5 0 2.5 2.3 2.5 4.2V22h3.6v-8.1Z' },
    { label: 'Email', href: `mailto:${site.email}`, hint: 'Write to my Gmail address', kind: 'email', path: 'M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 8 9-6H3l9 6Zm-9 6h18V8l-9 6-9-6v10Z' },
];
---

<div class="social-links" role="group" aria-label="Find me online">
    {links.map(link => (
        <a class={`social-link social-link--${link.kind}`} href={link.href}
            target={link.kind === 'email' ? undefined : '_blank'} rel={link.kind === 'email' ? undefined : 'noreferrer'}>
            <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path d={link.path} /></svg>
            <span>{link.label}</span>
            <span class="social-tooltip" aria-hidden="true">{link.hint}</span>
        </a>
    ))}
</div>

<style>
    .social-links { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.6rem; }
    .social-link {
        position: relative; display: inline-flex; align-items: center; justify-content: center;
        min-height: 2.9rem; gap: 0.55rem; padding: 0.55rem 0.85rem;
        border: 1px solid var(--border-strong); border-radius: 0.45rem;
        background: rgba(255,255,255,0.06); color: var(--text-main);
        font-size: var(--text-sm); font-weight: 500; text-decoration: none;
        transition: background 180ms ease, color 180ms ease, transform 180ms ease, border-color 180ms ease;
    }
    svg { flex-shrink: 0; }
    .social-link:hover, .social-link:focus-visible { transform: translateY(-2px); background: var(--text-main); color: var(--bg-main); border-color: var(--text-main); }
    .social-link--linkedin:hover, .social-link--linkedin:focus-visible { background: #0a66c2; border-color: #60a5fa; color: white; }
    .social-link--email:hover, .social-link--email:focus-visible { background: var(--cyan-bright); border-color: var(--cyan-bright); color: var(--bg-main); }
    .social-tooltip {
        position: absolute; left: 50%; bottom: calc(100% + 0.55rem); transform: translate(-50%, 4px);
        padding: 0.4rem 0.6rem; border: 1px solid var(--border-strong); border-radius: 0.35rem;
        color: var(--text-main); background: var(--bg-panel); white-space: nowrap; font-size: var(--text-xs);
        opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 180ms ease, transform 180ms ease; z-index: 2;
    }
    .social-link:hover .social-tooltip, .social-link:focus-visible .social-tooltip { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
    .social-link:first-child .social-tooltip { left: 0; transform: translateY(4px); }
    .social-link:last-child .social-tooltip { left: auto; right: 0; transform: translateY(4px); }
    .social-link:first-child:hover .social-tooltip, .social-link:first-child:focus-visible .social-tooltip,
    .social-link:last-child:hover .social-tooltip, .social-link:last-child:focus-visible .social-tooltip { transform: translateY(0); }
    @media (max-width: 400px) { .social-links { gap: 0.4rem; } .social-link { padding-inline: 0.55rem; gap: 0.4rem; } }
</style>
