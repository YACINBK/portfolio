---
---
<div class="bg-aura" aria-hidden="true">
    <div class="bg-aura__mesh"></div>
    <div class="bg-aura__scanline"></div>
    <div class="bg-aura__noise"></div>
    <div class="bg-aura__blob bg-aura__blob--left"></div>
    <div class="bg-aura__blob bg-aura__blob--right"></div>
    <div class="bg-aura__blob bg-aura__blob--ambient"></div>
</div>

<style>
    .bg-aura {
        position: fixed;
        inset: 0;
        z-index: -2;
        overflow: hidden;
        pointer-events: none;
        background: #04070c;
    }

    .bg-aura__mesh {
        position: absolute;
        inset: -100%;
        background-image: 
            linear-gradient(rgba(34, 211, 238, 0.45) 1.5px, transparent 1.5px),
            linear-gradient(90deg, rgba(34, 211, 238, 0.45) 1.5px, transparent 1.5px);
        background-size: 100px 100px;
        transform: perspective(1000px) rotateX(60deg) translateY(-200px) translateZ(0);
        animation: meshDrift 12s linear infinite;
        mask-image: radial-gradient(ellipse at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
    }

    .bg-aura__noise {
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.08;
        mix-blend-mode: overlay;
        z-index: 1;
    }

    .bg-aura__blob {
        position: absolute;
        filter: blur(80px);
        mix-blend-mode: screen;
        border-radius: 50%;
        animation: pulseAura 6s ease-in-out infinite alternate;
        z-index: 2;
    }

    .bg-aura__blob--left {
        top: 15%;
        left: -10%;
        width: 35vw;
        height: 60vh;
        background: radial-gradient(circle, rgba(34, 211, 238, 0.25) 0%, transparent 60%);
        animation-delay: 0s;
    }

    .bg-aura__blob--right {
        bottom: 5%;
        right: -5%;
        width: 40vw;
        height: 50vh;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.20) 0%, transparent 60%);
        animation-delay: -3s;
    }

    .bg-aura__blob--ambient {
        top: -10%;
        left: 30%;
        width: 70vw;
        height: 50vh;
        background: radial-gradient(circle, rgba(34, 211, 238, 0.15) 0%, transparent 60%);
        animation-delay: -1s;
    }

    @keyframes pulseAura {
        0% { transform: scale(1) translate(0, 0); opacity: 0.6; }
        50% { transform: scale(1.25) translate(4%, 5%); opacity: 1; }
        100% { transform: scale(0.85) translate(-4%, -3%); opacity: 0.7; }
    }

    .bg-aura::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 50%, rgba(34, 211, 238, 0.05) 50%);
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 10;
    }

    .bg-aura__scanline {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        background: linear-gradient(to bottom, 
            transparent, 
            rgba(34, 211, 238, 0) 40%, 
            rgba(34, 211, 238, 0.15) 50%, 
            rgba(34, 211, 238, 0) 60%, 
            transparent);
        opacity: 0.5;
        pointer-events: none;
        animation: scanline 8s linear infinite;
        z-index: 5;
    }

    @keyframes meshDrift {
        0% { transform: perspective(1000px) rotateX(60deg) translateY(0); }
        100% { transform: perspective(1000px) rotateX(60deg) translateY(100px); }
    }

    @keyframes scanline {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(100%); }
    }

    @media (max-width: 900px) {
        .bg-aura__mesh {
            opacity: 0.35;
            animation: none;
        }

        .bg-aura__scanline {
            display: none;
        }

        .bg-aura__blob {
            filter: blur(48px);
            animation: none;
        }
    }
</style>
