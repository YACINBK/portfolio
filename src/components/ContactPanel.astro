---
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import CopyEmail from './CopyEmail.astro';
import CvDownloads from './CvDownloads.astro';
import SocialLinks from './SocialLinks.astro';
const emailFor = (subject) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<dialog id="contact-panel" aria-labelledby="contact-panel-title" aria-describedby="contact-panel-description">
    <div class="panel-topline">
        <span>Yassine Ben Kacem · Let’s connect</span>
        <button type="button" class="panel-close" data-contact-close aria-label="Close contact panel" autofocus>×</button>
    </div>
    <h2 id="contact-panel-title">Let’s build<br />what comes next.</h2>
    <p id="contact-panel-description">Agentic AI, retrieval, and automation. Explore my code, connect, or bring me an opportunity.</p>
    <SocialLinks />
    <div class="panel-options">
        <a href={emailFor('Internship opportunity — Agentic AI / RAG')}>
            <span><strong>Discuss an internship</strong><small>AI engineering · RAG · Automation</small></span>
            <span aria-hidden="true">↗</span>
        </a>
        <a href={emailFor('Project collaboration — Agentic AI / RAG')}>
            <span><strong>Bring me a project</strong><small>Agents · Backends · Intelligent workflows</small></span>
            <span aria-hidden="true">↗</span>
        </a>
    </div>
    <p class="panel-email-note">Email options open your email app.</p>
    <div class="panel-email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <CopyEmail email={site.email} />
    </div>
    <div class="panel-resources">
        <CvDownloads />
    </div>
    <a class="panel-all-contact" href={withBase('/contact')} data-contact-page>All contact details <span aria-hidden="true">→</span></a>
</dialog>

<style>
    dialog {
        width: min(38rem, calc(100vw - 1.5rem)); max-height: calc(100dvh - 2rem);
        padding: clamp(1.15rem, 4vw, 2rem); margin: auto;
        overflow-y: auto; overscroll-behavior: contain;
        background: var(--bg-panel); color: var(--text-main);
        border: 1px solid var(--cyan-soft); border-top: 3px solid var(--cyan-main);
        border-radius: 0.85rem; box-shadow: 0 24px 100px rgba(0,0,0,0.6);
    }
    dialog::backdrop { background: rgba(2, 6, 12, 0.82); backdrop-filter: blur(6px); }
    dialog[open] { animation: panel-arrive 220ms ease-out; }
    .panel-topline { display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: var(--cyan-bright); font-size: var(--text-sm); }
    .panel-close {
        flex: 0 0 2.75rem; width: 2.75rem; height: 2.75rem; border-radius: 50%;
        border: 1px solid var(--border-medium); background: transparent; color: var(--text-main);
        font-size: var(--text-2xl); cursor: pointer;
    }
    .panel-close:hover { background: var(--cyan-dim); border-color: var(--cyan-main); }
    h2 { margin: 1rem 0; font-size: clamp(2rem, 6vw, 3rem); line-height: 1.08; letter-spacing: -0.045em; }
    #contact-panel-description { color: var(--text-soft); font-size: var(--text-base); line-height: 1.6; max-width: 45ch; }
    .panel-options { display: grid; gap: 0.75rem; margin-top: 1.5rem; }
    .panel-options a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid var(--border-strong); border-radius: 0.4rem; text-decoration: none; transition: background 180ms ease, border-color 180ms ease; }
    .panel-options a:first-child { background: var(--cyan-main); color: var(--bg-main); border-color: var(--cyan-main); }
    .panel-options a:first-child:hover { background: var(--cyan-bright); }
    .panel-options a:last-child:hover { background: var(--cyan-dim); border-color: var(--cyan-main); }
    .panel-options strong { display: block; font-size: var(--text-lg); }
    .panel-options small { display: block; margin-top: 0.3rem; font-size: var(--text-xs); line-height: 1.5; }
    .panel-options a > span:last-child { font-size: var(--text-xl); transition: transform 180ms ease; }
    .panel-options a:hover > span:last-child { transform: translate(3px,-3px); }
    .panel-email-note { margin: 0.75rem 0 0; color: var(--text-muted); font-size: var(--text-xs); }
    .panel-email { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; padding-block: 0.5rem 1rem; }
    .panel-email > a { display: flex; align-items: center; min-height: 2.75rem; overflow-wrap: anywhere; font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 0.25em; }
    .panel-resources { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; border-top: 1px solid var(--border-medium); padding-top: 1rem; }
    .panel-resources > a, .panel-all-contact { display: inline-flex; gap: 0.75rem; align-items: center; min-height: 2.75rem; color: var(--cyan-bright); font-size: var(--text-sm); }
    .panel-all-contact { margin-top: 0.5rem; color: var(--text-soft); }
    @keyframes panel-arrive { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
</style>

<script>
    let opener: HTMLElement | null = null;
    const boundPanels = new WeakSet<HTMLDialogElement>();

    function bindPanel() {
        const panel = document.querySelector<HTMLDialogElement>('#contact-panel');
        if (!panel || boundPanels.has(panel)) return;
        boundPanels.add(panel);
        panel.addEventListener('keydown', event => {
            if (event.key !== 'Tab') return;
            const controls = Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
                .filter(control => !control.hidden && control.getClientRects().length > 0);
            const first = controls[0];
            const last = controls[controls.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault(); last?.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault(); first?.focus();
            }
        });
        panel.addEventListener('close', () => {
            document.documentElement.classList.remove('contact-panel-open');
            if (opener?.isConnected) opener.focus();
            opener = null;
        });
        panel.addEventListener('click', event => {
            const rect = panel.getBoundingClientRect();
            if (event.target === panel && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) panel.close();
        });
    }

    document.addEventListener('click', event => {
        if (!(event.target instanceof Element)) return;
        const panel = document.querySelector<HTMLDialogElement>('#contact-panel');
        if (!panel) return;
        if (event.target.closest('[data-contact-close]')) { panel.close(); return; }
        if (event.target.closest('[data-contact-page]')) { panel.close(); return; }
        const trigger = event.target.closest<HTMLElement>('[data-contact-trigger]');
        if (!trigger || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (typeof panel.showModal !== 'function') return;
        event.preventDefault();
        bindPanel();
        opener = trigger;
        panel.querySelectorAll('[role="status"]').forEach(status => { status.textContent = ''; });
        panel.showModal();
        document.documentElement.classList.add('contact-panel-open');
    }, true);

    document.addEventListener('astro:before-swap', () => {
        opener = null;
        document.querySelector<HTMLDialogElement>('#contact-panel')?.close();
        document.documentElement.classList.remove('contact-panel-open');
    });
    document.addEventListener('astro:page-load', bindPanel);
    bindPanel();
</script>
